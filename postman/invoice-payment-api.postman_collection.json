                }
              }
            },
            "url": "{{baseUrl}}/payments"
          }
        },
        {
          "name": "Get payment by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/payments/{{paymentId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Returns 200 OK', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Update payment",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"payment_id\": \"{{paymentId}}\",\n  \"invoice_id\": \"{{invoiceId}}\",\n  \"paid\": 2400\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/payments/{{paymentId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Returns 200 OK', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete payment",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/payments/{{paymentId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Returns 204 No Content', function () { pm.response.to.have.status(204); });"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
